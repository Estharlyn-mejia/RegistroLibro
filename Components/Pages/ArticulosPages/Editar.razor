@page "/editar-libro/{LibroId:int}"
@rendermode InteractiveServer

@using RegistroLibro.Models

@inject GestionLibro GestionLibro
@inject NavigationManager Navigation

<PageTitle>Editar Libro</PageTitle>

<div class="container mt-4">

    <div class="card">

        @*Encabezado*@
        <div class="card-header text-center">
            <h3>Editar Libro</h3>
        </div>

        @*Formulario*@
        <div class="card-body">

            @*LibroId*@
            <div class="mb-3">
                <label class="form-label">
                    LibroId
                </label>

                <input type="text"
                       class="form-control"
                       @bind="libro.LibroId"
                       disabled />
            </div>

            <!-- Título -->
            <div class="mb-3">
                <label class="form-label">
                    Titulo
                </label>

                <input type="text"
                       class="form-control"
                       @bind="libro.Titulo" />
            </div>

            @*Autor*@
            <div class="mb-3">
                <label class="form-label">
                    Autor
                </label>

                <input type="text"
                       class="form-control"
                       @bind="libro.Autor" />
            </div>

            @*Año de publicación*@
            <div class="mb-3">
                <label class="form-label">
                    AnoPublicacion
                </label>

                <input type="number"
                       class="form-control"
                       @bind="libro.AnoPublicacion" />
            </div>

            @*Mensaje*@
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-danger">
                    @mensaje
                </div>
            }

        </div>

        @*Botones*@
        <div class="card-footer">

            <div class="d-flex justify-content-center gap-2">

                @*Volver*@
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="Volver">
                    ⏪ Volver
                </button>

                @*Modificar*@
                <button type="button"
                        class="btn btn-primary"
                        @onclick="Modificar">
                    💾 Modificar
                </button>

                @*Eliminar*@
                <button type="button"
                        class="btn btn-danger"
                        @onclick="Eliminar">
                    🗑️ Eliminar
                </button>

            </div>

        </div>

    </div>

</div>

@code
{
    [Parameter]
    public int LibroId { get; set; }

    private RegistroLibro.Models.Libros libro =
        new RegistroLibro.Models.Libros();

    private string mensaje = "";

    protected override async Task OnInitializedAsync()
    {
        RegistroLibro.Models.Libros? resultado =
            await GestionLibro.Buscar(LibroId);

        if (resultado != null)
        {
            libro = resultado;
        }
        else
        {
            mensaje = "No se encontró el libro.";
        }
    }

    private async Task Modificar()
    {
        if (string.IsNullOrWhiteSpace(libro.Titulo))
        {
            mensaje = "El título es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(libro.Autor))
        {
            mensaje = "El autor es obligatorio.";
            return;
        }

        if (libro.AnoPublicacion <= 0)
        {
            mensaje = "El año de publicación debe ser un número positivo.";
            return;
        }

        bool resultado =
            await GestionLibro.Modificar(libro);

        if (resultado)
        {
            Navigation.NavigateTo("/libros");
        }
        else
        {
            mensaje = "Error al modificar el libro.";
        }
    }

    private async Task Eliminar()
    {
        bool resultado =
            await GestionLibro.Eliminar(LibroId);

        if (resultado)
        {
            Navigation.NavigateTo("/libros");
        }
        else
        {
            mensaje = "Error al eliminar el libro.";
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/libros");
    }
}