@page "/Prestamo/Crear"
@inject GestionLibro gestionLibro
@inject EstudianteServices estudianteServices
@inject PrestamosServices prestamosServices
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Crear préstamo</PageTitle>
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h4 class="mb-0">Crear préstamo</h4>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(mensaje)) {
                <div class="alert alert-danger">
                    @mensaje
                </div> 
            }
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">
                        Estudiante
                    </label>
                    <select class="form-select" @bind="prestamo.EstudianteId">
                        <option value="0">Seleccione un estudiante</option>
                        @foreach (var estudiante in listaEstudiantes) { 
                            <option value="@estudiante.EstudianteId">
                                    @estudiante.Nombre
                            </option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        Fecha del préstamo 
                    </label>
                    
                    <input class="form-control" 
                            type="date" 
                            @bind="fechaPrestamo" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">
                        Fecha de devolución (opcional)
                        </label>
                    <input class="form-control" 
                            type="date" 
                            @bind="fechaDevolucion" />
                </div>
            </div>

            <section class="border rounded mt-4">
                <h5 class="bg-light border-bottom p-3 mb-0">
                    Libros del préstamo
                </h5>
                <div class="p-3">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-7">
                            <label class="form-label">
                                Libro
                            </label>
                            <select class="form-select" 
                                    @bind="libroSeleccionadoId">
                                <option value="0">
                                    Seleccione un libro
                                </option>
                                @foreach (var libro in listaLibros.Where(l => l.Cantidad > 0)) { 
                                    <option value="@libro.LibroId">@libro.Titulo — disponibles: @Disponibles(libro.LibroId)</option> }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">
                                Cantidad
                            </label>
                            <input class="form-control" 
                                    type="number" 
                                    min="1" 
                                    @bind="cantidadSeleccionada" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" 
                                    class="btn btn-primary w-100" 
                                    @onclick="AgregarLibro">
                                    <i class="bi bi-plus-lg"></i> 
                                Agregar
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table table-bordered table-striped align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Libro</th>
                                    <th>Disponibles</th>
                                    <th style="width: 150px">
                                        Cantidad a prestar
                                    </th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var detalle in prestamo.Detalles)
                                {
                                    var libro = listaLibros.FirstOrDefault(l => l.LibroId == detalle.LibroId);
                                    <tr>
                                        <td>@(libro?.Titulo ?? "Libro no encontrado")</td>
                                        <td>@Disponibles(detalle.LibroId)</td>
                                        <td><input class="form-control" 
                                                    type="number" 
                                                    min="1" max="@((libro?.Cantidad ?? 0) + detalle.Cantidad)" @bind="detalle.Cantidad" /></td>
                                        <td>
                                            <button type="button" 
                                                    class="btn btn-outline-danger" 
                                                    @onclick="() => QuitarLibro(detalle)">Quitar
                                            </button>
                                        </td>
                                    </tr>
                                }
                                @if (prestamo.Detalles.Count == 0) { 
                                    <tr>
                                        <td colspan="4" 
                                            class="text-center text-muted">
                                            Agregue uno o más libros.
                                        </td>
                                    </tr> }
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
        </div>
        <div class="card-footer bg-light d-flex justify-content-center gap-2">
            <button class="btn btn-outline-secondary" 
                    @onclick="Volver">
                Volver
            </button>
            <button class="btn btn-success" 
                    @onclick="Guardar">
                Guardar préstamo
            </button>
        </div>
    </div>
</div>

@code {
    private Prestamo prestamo = new() { Estado = "Prestado" };
    private List<Estudiantes> listaEstudiantes = [];
    private List<Libros> listaLibros = [];
    private int libroSeleccionadoId;
    private int cantidadSeleccionada = 1;
    private string mensaje = string.Empty;
    private DateTime fechaPrestamo = DateTime.Today;
    private DateTime? fechaDevolucion;

    protected override async Task OnInitializedAsync()
    {
        listaEstudiantes = await estudianteServices.GetList(e => e.EstudianteId > 0);
        listaLibros = await gestionLibro.ObtenerTodos();
    }

    private int Disponibles(int libroId)
    {
        var libro = listaLibros.FirstOrDefault(l => l.LibroId == libroId);
        var enCarrito = prestamo.Detalles.Where(d => d.LibroId == libroId).Sum(d => d.Cantidad);
        return Math.Max(0, (libro?.Cantidad ?? 0) - enCarrito);
    }

    private void AgregarLibro()
    {
        mensaje = string.Empty;
        if (libroSeleccionadoId <= 0 || cantidadSeleccionada <= 0) { 
            mensaje = "Seleccione un libro y una cantidad válida."; 
            return;
            }
        if (cantidadSeleccionada > Disponibles(libroSeleccionadoId)) { 
            mensaje = "La cantidad supera las unidades disponibles."; 
            return; 
            }
        var detalle = prestamo.Detalles.FirstOrDefault(d => d.LibroId == libroSeleccionadoId);
        if (detalle is null) prestamo.Detalles.Add(new PrestamoDetalle { 
            LibroId = libroSeleccionadoId, Cantidad = cantidadSeleccionada 
            });
        else detalle.Cantidad += cantidadSeleccionada;
        libroSeleccionadoId = 0;
        cantidadSeleccionada = 1;
    }

    private void QuitarLibro(PrestamoDetalle detalle) => prestamo.Detalles.Remove(detalle);

    private async Task Guardar()
    {
        mensaje = string.Empty;
        if (prestamo.EstudianteId <= 0) { 
            mensaje = "Seleccione un estudiante."; 
            return; 
        }
        if (prestamo.Detalles.Count == 0 || prestamo.Detalles.Any(d => d.Cantidad <= 0)) { 
            mensaje = "Agregue libros y cantidades válidas."; 
            return; 
        }
        if (fechaPrestamo == default || fechaPrestamo.Date > DateTime.Today) { 
            mensaje = "La fecha del préstamo no es válida."; 
            return; 
        }
        prestamo.FechaPrestamo = fechaPrestamo;
        prestamo.FechaDevolucion = fechaDevolucion;
        if (fechaDevolucion.HasValue && fechaDevolucion.Value.Date < fechaPrestamo.Date) { 
            mensaje = "La fecha de devolución no puede preceder al préstamo."; 
            return; 
        }
        prestamo.Estado = "Prestado";
        if (await prestamosServices.Guardar(prestamo, prestamo.Detalles)){ 
            Navigation.NavigateTo("/Prestamo/Index");
        }
        else mensaje = "No se pudo guardar: revise las existencias disponibles.";
    }

    private void Volver(){
        Navigation.NavigateTo("/Prestamo/Index");
    }
}
