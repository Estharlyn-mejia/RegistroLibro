@page "/Prestamo/Devueltos"

@inject PrestamosServices prestamosServices
@inject EstudianteServices estudianteServices
@inject GestionLibro gestionLibro
@rendermode InteractiveServer

<PageTitle>Préstamos devueltos</PageTitle>

<div class="container-fluid mt-4">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Préstamos devueltos</h5>
            <a href="/Prestamo/Index" class="btn btn-outline-secondary">
                <span class="bi bi-arrow-left"></span>
                Volver a préstamos
            </a>
        </div>

        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert alert-danger">@mensaje</div>
            }

            <QuickGrid Items="ListaPrestamos.AsQueryable()"
                       Class="table table-bordered mt-2 text-center">
                <PropertyColumn Property="prestamo => prestamo.PrestamoId" Title="Préstamo" Sortable="true" />
                <TemplateColumn Title="Estudiante">
                    @(ListaEstudiantes.FirstOrDefault(estudiante => estudiante.EstudianteId == context.EstudianteId)?.Nombre ?? "No encontrado")
                </TemplateColumn>
                <TemplateColumn Title="Libro">
                    @(ListaLibros.FirstOrDefault(libro => libro.LibroId == context.LibroId)?.Titulo ?? "No encontrado")
                </TemplateColumn>
                <TemplateColumn Title="Cantidad">
                    @(ListaLibros.FirstOrDefault(libro => libro.LibroId == context.LibroId)?.Cantidad ?? 0)
                </TemplateColumn>
                <PropertyColumn Property="prestamo => prestamo.FechaPrestamo" Title="Fecha préstamo" Sortable="true" />
                <TemplateColumn Title="Fecha devolución" Sortable="true">
                    @(context.FechaDevolucion?.ToShortDateString() ?? "-")
                </TemplateColumn>
            </QuickGrid>

            <p class="mt-3 mb-0">
                <strong>Total devueltos:</strong> @ListaPrestamos.Count
            </p>
        </div>
    </div>
</div>

@code
{
    private List<Prestamo> ListaPrestamos { get; set; } = [];
    private List<Estudiantes> ListaEstudiantes { get; set; } = [];
    private List<Libros> ListaLibros { get; set; } = [];
    private string mensaje = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        ListaPrestamos = await prestamosServices.GetList(prestamo => prestamo.Estado == "Devuelto");
        ListaEstudiantes = await estudianteServices.GetList(estudiante => estudiante.EstudianteId > 0);
        ListaLibros = await gestionLibro.ObtenerTodos();
    }
}
