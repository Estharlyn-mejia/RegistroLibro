```razor
@page "/crear-libro"

@using RegistroLibro.Models

@rendermode InteractiveServer

@inject GestionLibro GestionLibro
@inject NavigationManager Navigation

<PageTitle>Crear Libro</PageTitle>

<EditForm Model="@libro" OnValidSubmit="@Guardar">
    <DataAnnotationsValidator />

    <div class="container mt-4">

        <div class="card shadow-lg">

            @*Encabezado*@
            <div class="card-header text-center">
                <h3>
                    <strong>Crear un nuevo libro</strong>
                </h3>
            </div>

            @*Formulario*@
            <div class="card-body">

                <div class="row">

                    @*LibroId*@
                    <div class="col-2">
                        <label class="form-label" for="LibroId">
                            <strong>LibroId</strong>
                        </label>

                        <InputNumber class="form-control"
                                    id="LibroId"
                                    @bind-Value="libro.LibroId"
                                    readonly>
                        </InputNumber>
                    </div>

                    @* Titulo *@
                    <div class="col-5">
                        <label class="form-label" for="Titulo">
                            <strong>Título</strong>
                        </label>

                        <InputText class="form-control"
                                    id="Titulo"
                                    @bind-Value="libro.Titulo">
                        </InputText>

                        <ValidationMessage For="(() => libro.Titulo)" />
                    </div>

                    @* Autor *@
                    <div class="col-5">
                        <label class="form-label" for="Autor">
                            <strong>Autor</strong>
                        </label>

                        <InputText class="form-control"
                                    id="Autor"
                                    @bind-Value="libro.Autor">
                        </InputText>

                        <ValidationMessage For="(() => libro.Autor)" />
                    </div>

                    @*Año de publicación*@
                    <div class="col-4 mt-3">
                        <label class="form-label" for="AnoPublicacion">
                            <strong>Año de publicación</strong>
                        </label>

                        <InputNumber class="form-control"
                                    id="AnoPublicacion"
                                    @bind-Value="libro.AnoPublicacion">
                        </InputNumber>

                        <ValidationMessage For="(() => libro.AnoPublicacion)" />
                    </div>

                </div>

            </div>

            @*Botones*@
            <div class="card-footer text-center">

                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="Volver">
                    ⬅️ Volver
                </button>

                <button type="submit"
                        class="btn btn-outline-success">
                    💾 Crear
                </button>

            </div>

        </div>

    </div>

</EditForm>

@code
{
    private RegistroLibro.Models.Libros libro = new RegistroLibro.Models.Libros();

    private async Task Guardar()
    {
        var crear = await GestionLibro.Guardar(libro);

        if (crear)
        {
            Volver();
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/libros");
    }
}
```
