@page "/editor-estudiante/{EstudianteId:int}"


@inject EstudianteServices estudianteServices
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Editar Estudiante</PageTitle>

<div class="container mt-4">
    <div class="card">

        @*Encabezado*@
        <div class="card-header text-center">
            <h3>Editar Estudiante</h3>
        </div>

        @*Formulario*@
        <div class="card-body">

            @*EstudianteId*@
            <div class="mb-3">
                <label class="form-label">
                    EstudianteId
                </label>

                <input type="text"
                        class="form-control"
                        @bind="estudiantes.EstudianteId"
                        disabled />
            </div>

            @*Nombre*@
            <div class="mb-3">
                <label class="form-label">
                    Nombre
                </label>

                <input type="text"
                        class="form-control"
                        @bind="estudiantes.Nombre" />
            </div>

            @*Direccion*@
            <div class="mb-3">
                <label class="form-label">
                    Direccion
                </label>

                <input type="text"
                        class="form-control"
                        @bind="estudiantes.Direccion" />
            </div>

            @*Email*@
            <div class="mb-3">
                <label class="form-label">
                    Email
                </label>

                <input type="text"
                        class="form-control"
                        @bind="estudiantes.Emil" />
            </div>

            @*Fecha*@
            <div class="mb-3">
                <label class="form-label">
                    Fecha
                </label>

                <input type="date"
                        class="form-control"
                        @bind="estudiantes.Fecha" />
            </div>

            @*Mensaje*@
            @if (!string.IsNullOrEmpty(mensaje))
            {
                <div class="alert alert-danger">
                    @mensaje
                </div>
            }
        </div>

        @*Botones*@
        <div class="card-footer">
            <div class="d-flex justify-content-center gap-2">

                @*Volver*@
                <button type="button"
                        class="btn btn-secondary"
                        @onclick="Volver">
                    ⏪ Volver
                </button>

                @*Modificar*@
                <button type="button"
                        class="btn btn-primary"
                        @onclick="Modificar">
                    💾 Modificar
                </button>

                @*Eliminar*@
                <button type="button"
                        class="btn btn-danger"
                        @onclick="MostrarConfirmacion">
                    🗑️ Eliminar
                </button>
            </div>
        </div>
    </div>
</div>
@if (mostrarConfirmacion)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header justify-content-center">
                    <h5 class="modal-title">Confirmar Eliminacion</h5>
                </div>

            <div class="modal-body text-center">
                <p>¿Seguro de que desea Eliminarlo?</p>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="butto"
                        class="btn btn-secondary"
                        @onclick="CancelarEliminar">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger"
                        @onclick="ConfirmarEliminar">
                    Si, Eliminar
                </button>
            </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code{
    [Parameter]
    public int EstudianteId{get; set;}

    private RegistroLibro.Models.Estudiantes estudiantes = new RegistroLibro.Models.Estudiantes();

    private string mensaje = "";

    private bool mostrarConfirmacion = false;

    protected override async Task OnInitializedAsync()
    {
        RegistroLibro.Models.Estudiantes? resultado = await estudianteServices.Buscar(EstudianteId);

        if(resultado != null)
        {
            estudiantes = resultado;
        }
        else
        {
            mensaje = "No encontrado";
        }
    }

    private async Task Modificar()
    {
        if(string.IsNullOrWhiteSpace(estudiantes.Nombre))
        {
            mensaje = "El nombre es obligatorio";
            return;
        }
        if (string.IsNullOrWhiteSpace(estudiantes.Direccion))
        {
            mensaje = "La Direccion es obligatoria";
            return;
        }
        if (string.IsNullOrWhiteSpace(estudiantes.Emil))
        {
            mensaje = "El Email es obligatorio";
            return;
        }
        if(estudiantes.Fecha > DateTime.Now)
        {
            mensaje = "La fecha no puede ser mayor a la actual";
            return;
        }

        bool resultado = await estudianteServices.Modificar(estudiantes);

        if (resultado)
        {
            Navigation.NavigateTo("/ArticulosPages/Estudiantes");
        }
        else
        {
            mensaje = "Error al modificar el estudiante";
        }
    }

    private void MostrarConfirmacion()
    {
        mostrarConfirmacion = true;
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacion = false;
    }

    private async Task ConfirmarEliminar()
    {
        mostrarConfirmacion = false;

        bool resultado = await estudianteServices.Eliminar(EstudianteId);

        if (resultado)
        {
            Navigation.NavigateTo("/ArticulosPages/Estudiantes");
        }
        else
        {
            mensaje = "Error al eliminar el estudiante";
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/ArticulosPages/Estudiantes");
    }

}