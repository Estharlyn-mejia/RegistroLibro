@page "/libros"
@rendermode InteractiveServer
@inject GestionLibro GestionLibro
@inject NavigationManager Navigation
<PageTitle>Biblioteca</PageTitle>

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Consulta de Libros</h5>
            <a href="/crear-libro" class="btn btn-primary">
                <span class="bi bi-plus-square"></span>
                Crear
            </a>
        </div>

    @*Formulario*@
    <div class="card-body">

        @*Labels*@
        <div class="row">

            <div class="col-3">
                <label class="form-label" for="Filtro">
                    <strong>Filtrar por</strong>
                </label>
            </div>

            <div class="col-4">
                <label class="form-label" for="valorFiltro">
                    <strong>Búsqueda</strong>
                </label>
            </div>

        </div>

        @*Inputs y botones*@
        <div class="row">

            @* Filtro *@
            <div class="col-3">

                <select class="form-select" @bind="filtro">

                    <option value="">
                        Elija una opción
                    </option>

                    <option value="Id">
                        Id
                    </option>

                    <option value="Titulo">
                        Título
                    </option>

                    <option value="Autor">
                        Autor
                    </option>

                    <option value="AnoPublicacion">
                        Año de Publicación
                    </option>

                </select>

            </div>

            @* Búsqueda *@
            <div class="col-4">

                <div class="input-group">
                    <input class="form-control"
                            @bind="valorFiltro"
                            placeholder="Buscar" />

                    <button type="button"
                            class="btn btn-outline-primary"
                            @onclick="Buscar">
                        Buscar
                    </button>
                </div>
            </div>

            @*Restablecer*@
            <div class="col-auto">

                <button type="button"
                        class="btn btn-outline-secondary"
                        @onclick="Restablecer">
                    Restablecer
                </button>
            </div>
        </div>

        <QuickGrid Items="ListaLibros.AsQueryable()"
                    Class="table table-bordered mt-3 text-center">
            <PropertyColumn Property="libro => libro.LibroId" Title="LibroId" Sortable="true" />
            <PropertyColumn Property="libro => libro.Titulo" Title="Título" Sortable="true" />
            <PropertyColumn Property="libro => libro.Autor" Title="Autor" Sortable="true" />
            <PropertyColumn Property="libro => libro.AnoPublicacion" Title="Año de Publicación" Sortable="true" />
            <TemplateColumn Title="Acciones">
                <button type="button"
                        class="btn btn-outline-warning"
                        @onclick="() => MostrarPantallaEditar(context.LibroId)">
                    Editar
                </button>
                <button type="button"
                        class="btn btn-outline-danger"
                        @onclick="() => MostrarPantallaEliminar(context.LibroId)">
                    Eliminar
                </button>
            </TemplateColumn>
        </QuickGrid>
        <p>
            <strong>Cantidad:</strong> @ListaLibros.Count
        </p>
    </div>
</div>
</div>

@code
{
    public List<RegistroLibro.Models.Libros> ListaLibros { get; set; } = [];
    public string? filtro { get; set; }
    public string? valorFiltro { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ListaLibros = await GestionLibro.ObtenerTodos();
    }
    private async Task Buscar()
    {
        if (!string.IsNullOrWhiteSpace(valorFiltro))
        {
            if (filtro == "Id" &&
                int.TryParse(valorFiltro, out int libroId))
            {
                var libro = await GestionLibro.Buscar(libroId);
                if (libro != null)
                {
                    ListaLibros = [libro];
                }
                else
                {
                    ListaLibros = [];
                }
            }
            else if (filtro == "Titulo")
            {
                ListaLibros = (await GestionLibro.ObtenerTodos())
                    .Where(l => l.Titulo.ToLower()
                    .Contains(valorFiltro.ToLower()))
                    .ToList();
            }
            else if (filtro == "Autor")
            {
                ListaLibros = (await GestionLibro.ObtenerTodos())
                    .Where(l => l.Autor.ToLower()
                    .Contains(valorFiltro.ToLower()))
                    .ToList();
            }
            else if (filtro == "AnoPublicacion")
            {
                ListaLibros = (await GestionLibro.ObtenerTodos())
                    .Where(l => l.AnoPublicacion.ToString()
                    .Contains(valorFiltro))
                    .ToList();
            }
            else
            {
                ListaLibros = (await GestionLibro.ObtenerTodos())
                    .Where(l =>
                        l.Titulo.ToLower().Contains(valorFiltro.ToLower()) ||
                        l.Autor.ToLower().Contains(valorFiltro.ToLower()) ||
                        l.AnoPublicacion.ToString().Contains(valorFiltro))
                    .ToList();
            }
        }
        else
        {
            ListaLibros = await GestionLibro.ObtenerTodos();
        }
    }

    private async Task Restablecer()
    {
        ListaLibros = await GestionLibro.ObtenerTodos();
        filtro = string.Empty;
        valorFiltro = string.Empty;
    }

    public void MostrarPantallaCrear()
    {
        Navigation.NavigateTo("/crear-libro");
    }

    public void MostrarPantallaEditar(int id)
    {
        Navigation.NavigateTo($"/editar-libro/{id}");
    }
    public void MostrarPantallaEliminar(int id)
    {
        Navigation.NavigateTo($"/editar-libro/{id}");
    }
}