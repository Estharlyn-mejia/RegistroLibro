@page "/ArticulosPages/Estudiantes"

@inject EstudianteServices estudianteServices
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Estudiantes Art&iacute; culo</PageTitle>
<div class = "Container-fluid mt-4">
    <div class = "card shadow-lg">
        @*Header*@
        <div class="card-header">
            <div class = "text-center">
                <h3><strong>Consulta de Estudiante</strong></h3>
            </div>
            
            @*Body*@
            <div class="row">

                @*Body*@
                <div class="col-3">
                    <label class="form-label" for="Filtro">
                        <strong>Filtrar por</strong>
                    </label>
                </div>

                <div class="col-md-4">
                    <label class="form-label" for="valorFiltro">
                        <strong>Busqueda</strong>
                    </label>
                </div>
            </div>
            @*Inputs y botoes*@
            <div class="row g-3">

                @*Filtro*@
                <div class="col-3">
                    <select class="form-select" @bind="filtro">

                        <option value="">
                            Elija una opcion
                        </option>

                        <option value="Id">
                            Id
                        </option>

                        <option value="Nombre">
                            Nombre
                        </option>

                        <option value="Direccion">
                            Direccion
                        </option>

                        <option value="Email">
                            Email
                        </option>
                        <option value="Fecha">
                            Fecha
                        </option>
                    </select>
                </div>


                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">

                        <input class="form-control"
                        @bind="valorFiltro"
                        placeholder="Buscar" />

                        <button type="button"
                                class="btn btn-outline-primay"
                                @onclick="">
                            Buscar
                        </button>
                    </div>
                </div>

                @*Restablecer*@
                <div class="col-auto">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="Restablecer">
                        Restablecer
                    </button>
                </div>
            </div>

            @*Tabla*@
            <table class="table table-bordered mt-3 text-center">
                <thead>
                    <tr>
                        <th>Estudiante ID</th>
                        <th>Nombre</th>
                        <th>Direccion</th>
                        <th>Email</th>
                        <th>Fecha</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach(var estudiantes in ListaEstudiantes){
                        <tr>
                            <td>
                                @estudiantes.EstudianteId
                            </td>

                            <td>
                                @estudiantes.Nombre
                            </td>

                            <td>
                                @estudiantes.Direccion
                            </td>

                            <td>
                                @estudiantes.Emil
                            </td>

                            <td>
                                @estudiantes.Fecha
                            </td>

                            <td>
                                <button type="button"
                                        class="btn btn-outline-warning"
                                        @onclick="() => MostrarPantallaEditar(estudiantes.EstudianteId)">
                                    Editar
                                </button>

                                <button type="button"
                                        class="btn btn-outline-danger"
                                        @onclick="() => MostrarPantallaEliminar(estudiantes.EstudianteId)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p>
                <strong>Cantidad:</strong>@ListaEstudiantes.Count
            </p>
        </div>
    </div>

    @*Crear Libro*@
    <div class="container mt-3">
        <button type="button"
                class="btn btn-primary"
                @onclick="MostrarPatallaCrear">
            Crear Estudiante
        </button>
    </div>
</div>

@code{
    public List<RegistroLibro.Models.Estudiantes> ListaEstudiantes {get; set;} = new List<RegistroLibro.Models.Estudiantes>();

    public string? filtro{get; set;}

    public string? valorFiltro{get; set;}

    protected override async Task OnInitializedAsync()
    {
        ListaEstudiantes = await estudianteServices.ObtenerTodo();
    }

    private async Task Buscar()
    {
        if (!string.IsNullOrWhiteSpace(valorFiltro))
        {
            if(filtro =="Id" && int.TryParse(valorFiltro, out int estudianteId))
            {
                var estudinate = await estudianteServices.Buscar(estudianteId); 

                if(estudinate != null)
                {
                    ListaEstudiantes =[estudinate];
                }
                else
                {
                    ListaEstudiantes= [];
                }
            }
            else if(filtro == "Nombre")
            {
                ListaEstudiantes = (await estudianteServices.ObtenerTodo())
                    .Where(l => l.Nombre.ToLower()
                    .Contains(valorFiltro.ToLower()))
                    .ToList();
            }
            else if(filtro == "Direccion")
            {
                ListaEstudiantes = (await estudianteServices.ObtenerTodo())
                    .Where(l => l.Direccion.ToLower()
                    .Contains(valorFiltro.ToLower()))
                    .ToList();
            }
            else if(filtro == "Email")
            {
                ListaEstudiantes = (await estudianteServices.ObtenerTodo())
                    .Where(l => l.Emil.ToLower()
                    .Contains(valorFiltro.ToLower()))
                    .ToList();
            }
            else if(filtro == "Fecha")
            {
                ListaEstudiantes = (await estudianteServices.ObtenerTodo())
                    .OrderBy(l => l.Fecha)
                    .ToList();
            }
            else
            {
                ListaEstudiantes = (await estudianteServices.ObtenerTodo())
                    .Where(l =>
                        l.Nombre.ToLower().Contains(valorFiltro.ToLower()) ||
                        l.Direccion.ToLower().Contains(valorFiltro.ToLower()) ||
                        l.Emil.ToLower().Contains(valorFiltro))
                    .ToList();
            }
        }
        else
        {
            ListaEstudiantes = await estudianteServices.ObtenerTodo();
        }
    }

    private async Task Restablecer()
    {
        ListaEstudiantes = await estudianteServices.ObtenerTodo();
        filtro = string.Empty;
        valorFiltro = string.Empty;
    }

    public void MostrarPatallaCrear()
    {
        Navigation.NavigateTo("/Articulo/CrearEstudiantes");
    }

    public void MostrarPantallaEditar(int id)
    {
        Navigation.NavigateTo($"/editor-estudiante/{id}");
    }

    public void MostrarPantallaEliminar(int id)
    {
        Navigation.NavigateTo($"/editor-estudiante/{id}");
    }
}