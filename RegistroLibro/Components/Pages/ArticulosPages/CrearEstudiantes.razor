```razor
@page "/Articulo/CrearEstudiantes"

@inject EstudianteServices estudianteServices
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Crear Estudiante</PageTitle>

<EditForm Model="@estudiante" OnValidSubmit="@Guardar">

    <DataAnnotationsValidator />

    <div class="container mt-4">
        <div class="card shadow-lg">

            @*Encabezado*@
            <div class="card-header text-center">
                <h3>
                    <strong>Crear un nuevo estudiante</strong>
                </h3>
            </div>

            @* Formulario *@
            <div class="card-body">

                <div class="row">

                    @* EstudianteId *@
                    <div class="mb-3">
                        <label class="form-label" for="EstudianteId">
                            <strong>EstudianteId</strong>
                        </label>

                        <InputNumber class="form-control"
                                    id="EstudianteId"
                                    @bind-Value="estudiante.EstudianteId"
                                    readonly>
                        </InputNumber>
                    </div>

                    @*Nombre*@
                    <div class="mb-3">
                        <label class="form-label" for="Nombre">
                            <strong>Nombre</strong>
                        </label>

                        <InputText class="form-control"
                                    id="Nombre"
                                    @bind-Value="estudiante.Nombre">
                        </InputText>

                        <ValidationMessage For="() => estudiante.Nombre" />
                    </div>

                    @*Direccion*@
                    <div class="mt-3">
                        <label class="form-label" for="Dereccion">
                            <strong>Dereccion</strong>
                        </label>
                        <InputText class="form-control"
                                    id="Dereccion"
                                    @bind-Value="estudiante.Direccion">
                        </InputText>
                        <ValidationMessage For="(() => estudiante.Direccion)"/>
                    </div>

                    @*Email*@
                    <div class="mt-3">
                        <label class="form-label" for="Email">
                            <strong>Email</strong>
                        </label>
                        <InputText class="form-control"
                                    id="Email"
                                    @bind-Value="estudiante.Emil">
                        </InputText>

                        <ValidationMessage For="(() => estudiante.Emil)" />
                    </div>

                    @*Fecha*@
                    <div class="mt-3">
                        <label class="form-label" for="Fecha">
                            <strong>Fecha</strong>
                        </label>
                        <InputDate class="form-control"
                                    id="Fecha"
                                    @bind-Value="estudiante.Fecha">
                        </InputDate>

                        <ValidationMessage For="(() => estudiante.Fecha)" />
                    </div>

                </div>

                <br />

                @*Botones*@
                <div class="text-center mt-4">

                    <button type="submit" 
                            class="btn btn-primary me-4">
                            
                        💾 Guardar
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            @onclick="Volver">
                        ⬅️ Volver
                    </button>

                </div>

            </div>
        </div>
    </div>

</EditForm>

@code {

    private RegistroLibro.Models.Estudiantes estudiante =
        new RegistroLibro.Models.Estudiantes();

    private async Task Guardar()
    {
        var crear = await estudianteServices.Guardar(estudiante);

        if (crear)
        {
            Volver();
        }
    }

    private void Volver()
    {
        Navigation.NavigateTo("/ArticulosPages/Estudiantes");
    }
}
```
